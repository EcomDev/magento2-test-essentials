{
  "name": "ecomdev/magento2-test-essentials",
  "description": "Magento 2 Test Essentials",
  "type": "library",
  "require": {
    "magento/framework": "103.*",
    "magento/module-catalog": "~104.0",
    "magento/module-quote": "~101.0",
    "magento/module-customer": "~103.0",
    "magento/module-store": "~101.0",
    "php": "~8.4.0 || ~8.5.0"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^4.0",
    "phpunit/phpunit": "^13.4",
    "phpstan/phpstan": "^2.3.0",
    "brianium/paratest": "^7.29.0",
    "ecomdev/testcontainers-magento-data": "^2.0"
  },
  "suggest": {
    "ecomdev/testcontainers-magento-data": "Database Containers pre-populated with various data",
    "ext-pdo": "For database connections with ResourceConnection implementation"
  },
  "license": [
    "MIT"
  ],
  "keywords": [
    "magento2",
    "testing",
    "fake objects"
  ],
  "repositories": {
    "magento": {
      "type": "composer",
      "url": "https://mirror.mage-os.org/"
    }
  },
  "autoload": {
    "psr-4": {
      "EcomDev\\Magento2TestEssentials\\": "src"
    }
  },
  "autoload-dev": {
    "files": [
      "tests/fixtures/code.php"
    ],
    "psr-4": {
      "EcomDev\\Magento2TestEssentials\\": "tests"
    }
  },
  "scripts": {
    "test": "XDEBUG_MODE=coverage paratest --fail-on-all-issues --display-deprecations --coverage-text",
    "static:phpstan": "phpstan analyze -c phpstan.neon",
    "static:phpcs": "phpcs",
    "static": ["@static:phpstan", "@static:phpcs"],
    "format": "phpcbf"
  },
  "config": {
    "allow-plugins": {
      "magento/composer-dependency-version-audit-plugin": false,
      "php-http/discovery": false
    }
  },
  "$schema": "https://getcomposer.org/schema.json"
}
